      <column datatype='string' name='[Area]' role='dimension' type='nominal' />
      <column caption='Estimated Sales' datatype='integer' name='[Calculation_1150965339578368]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Price] * [Total ratings]' />
      </column>
      <column caption='Estimated Profit' datatype='real' name='[Calculation_1150965339713537]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1150965339578368] * 0.20' />
      </column>
      <column caption='Profit Ratio' datatype='real' name='[Calculation_1150965339803650]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1150965339713537]) / SUM([Calculation_1150965339578368])' />
      </column>
      <column caption='Frequency Segment' datatype='string' name='[Calculation_1150965355237379]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Total ratings] &gt;= 1000 THEN&#13;&#10;    &quot;High Frequency&quot;&#13;&#10;ELSEIF [Total ratings] &gt;= 500 THEN&#13;&#10;    &quot;Medium Frequency&quot;&#13;&#10;ELSE&#13;&#10;    &quot;Low Frequency&quot;&#13;&#10;END' />
      </column>
      <column caption='Monetary Segment' datatype='string' name='[Calculation_1150965355319300]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price] &gt;= 1000 THEN&#13;&#10;    &quot;High Monetary&quot;&#13;&#10;ELSEIF [Price] &gt;= 500 THEN&#13;&#10;    &quot;Medium Monetary&quot;&#13;&#10;ELSE&#13;&#10;    &quot;Low Monetary&quot;&#13;&#10;END' />
      </column>
      <column caption='High Value' datatype='string' name='[Calculation_1150965355409413]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price] &gt;= 1000 AND [Total ratings] &gt;= 1000 THEN&#13;&#10;    &quot;High Value&quot;&#13;&#10;ELSE&#13;&#10;    &quot;Other&quot;&#13;&#10;END' />
      </column>
      <column caption='Behavior Score' datatype='real' name='[Calculation_1150965376212998]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Total ratings] / 1000) + ([Price] / 1000) + [Avg ratings]' />
      </column>
